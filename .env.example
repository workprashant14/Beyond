# BEYOND needs NO secret keys today: NASA Image Library, JPL SBDB, JPL Horizons and the
# Exoplanet Archive are all keyless. If you later add a keyed NASA API (e.g. APOD),
# put the key here as a SERVER-ONLY variable (never prefix it with NEXT_PUBLIC_):
# NASA_API_KEY=

# Number of reverse proxies in front of the app that append to X-Forwarded-For (default 1: Vercel or one proxy).
# Used to pick the real client address for rate limiting. Use 2 behind CDN + load balancer, 0 to ignore the header.
# TRUSTED_PROXY_HOPS=1
